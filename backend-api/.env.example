# Environment Configuration for AI Software Factory Backend API

# Application Environment
# Options: development, production, test
NODE_ENV=development

# Server Port
# Default: 3000
PORT=3000

# JWT Configuration (CRITICAL - REQUIRED)
# Use a strong, random string in production (minimum 32 characters)
# Generate with: openssl rand -base64 32
# WARNING: If not set, the application will fail to start
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars

# JWT Token Expiration
# Duration format: https://github.com/vercel/ms (e.g., "15m", "1h", "7d")
JWT_EXPIRES_IN=15m

# CORS Configuration
# Allowed origins for cross-origin requests
# In production, set this to your frontend domain (e.g., https://example.com)
CORS_ORIGIN=http://localhost:3000

# Database Configuration (Optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai-factory
# DATABASE_POOL_SIZE=10

# Logging Level (Optional)
# Options: debug, info, warn, error
# LOG_LEVEL=info
