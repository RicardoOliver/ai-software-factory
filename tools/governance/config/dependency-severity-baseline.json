      "packageManager": "pnpm",
      "optional": true,
      "default": "critical"
    },
    "fixture-yarn-audit": {
      "path": "tools/governance/fixtures/yarn-audit",
      "packageManager": "yarn",
      "optional": true,
      "default": "critical"
    }
